# ---------- BatchMail ----------
# Public HTTPS address of this app (used in unsubscribe links). No trailing slash.
PUBLIC_BASE_URL=https://batchmail.domainanda.id
# Random secret, at least 32 characters: `openssl rand -hex 32`.
# Signs unsubscribe links and encrypts Cloudflare tokens — do not change it later.
APP_SECRET=
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://data/batchmail.db
# First dashboard user, created on first start when there are no users yet.
ADMIN_EMAIL=admin@domainanda.id
ADMIN_PASSWORD=

# ---------- Stalwart: SMTP submission (sending) ----------
# Use the hostname the TLS certificate is issued for.
SMTP_HOST=mail.domainanda.id
SMTP_PORT=587
# starttls (587) | tls (465) | none (only on a private network)
SMTP_TLS=starttls
SMTP_USER=batchmail@domainanda.id
SMTP_PASS=

# Public hostname of the Stalwart server, used in SPF (`a:<host>`).
# Defaults to SMTP_HOST; set it when SMTP_HOST is an internal name like "stalwart".
MAIL_HOSTNAME=mail.domainanda.id

# ---------- Stalwart: management API (automatic domain + DKIM setup) ----------
# In docker-compose: http://stalwart:8080/api . Otherwise https://mail.domainanda.id/api
STALWART_API_URL=http://stalwart:8080/api
# A Stalwart API key (Bearer) or "admin:password" (Basic).
STALWART_API_TOKEN=

# ---------- Cloudflare (optional) ----------
# Default token for automatic DNS (Zone › DNS › Edit). Can also be entered per domain in the dashboard.
CLOUDFLARE_API_TOKEN=

# ---------- Sending ----------
DEFAULT_RATE_PER_MINUTE=400
MAX_RECIPIENTS_API=10000
MAX_RECIPIENTS_DASHBOARD=100000
# Hours offset for times shown in the dashboard (WIB=7, WITA=8, WIT=9).
TZ_OFFSET_HOURS=7
# Only for development: allow sending from domains whose SPF/DKIM are not verified.
ALLOW_UNVERIFIED_DOMAINS=false
# RUST_LOG=batchmail=debug
